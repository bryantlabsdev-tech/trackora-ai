# Staging copy — never commit real secrets as .env.staging

NODE_ENV=staging
PORT=3001
APP_URL=https://staging.trackora.example.com

# Supabase staging project
SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=https://YOUR_STAGING_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Stripe test mode only
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...

OPENAI_API_KEY=
VITE_API_BASE_URL=https://staging-api.trackora.example.com

# Optional
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
