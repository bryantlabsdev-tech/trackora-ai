# Copy to `.env` in this folder and set your key. Never commit `.env`.
# Server-only — do not use a VITE_ prefix; the frontend never sees this value.

OPENAI_API_KEY=

# Server — Stripe Checkout (subscription). No VITE_ prefix.
# STRIPE_SECRET_KEY=sk_live_... or sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_ELITE_PRICE_ID=price_...
#   Pro checkout: STRIPE_PRICE_ID, then STRIPE_PRO_PRICE_ID, then hardcoded fallback ($8.99 Pro).
#   Elite checkout ($11.99): requires STRIPE_ELITE_PRICE_ID; subscription webhooks set profiles.plan_tier from this price id.
#   Signing secret from Stripe Dashboard → Webhooks → your endpoint.
# APP_URL=https://your-frontend.example.com
#   No trailing slash. Used for Checkout success_url / cancel_url (e.g. Vite dev: http://localhost:5173).
#
# Server — Supabase service role (webhook unlocks Pro on profiles). Never expose to the client.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional — one-time bulk resync (scripts/resync-stripe-billing.mjs or POST /api/billing/admin/resync-all):
# TRACKORA_BILLING_RESYNC_SECRET=long-random-string
#   Send header: x-trackora-billing-resync-secret: <same value>
#
# Optional:
# FREE_LIMIT=3
#   Max full coaching form generations for free tier (must match client FREE_AI_GENERATION_LIMIT).
# PRO_MONTHLY_REFINEMENT_LIMIT=25
#   Pro: section refinements per UTC calendar month (owner allowlist bypasses in app code).
# OPENAI_MODEL=gpt-4o-mini
# PORT=3001
#   Render sets PORT automatically; for local runs, defaults to 3001 if unset. Server binds to 0.0.0.0.

# Frontend (Vite) — API origin for ALL server calls (checkout, /api/ai, billing). No trailing slash.
# Unset + `npm run dev` → defaults to http://127.0.0.1:3001 (matches local Express).
# Production build unset → https://trackora-ai.onrender.com (override with your deploy URL).
# VITE_API_BASE_URL=http://127.0.0.1:3001

# Supabase (Vite) — required for sign-in; use Project URL + anon public key (Settings → API).
# VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_key
#
# Run supabase/migrations/001_profiles.sql in the Supabase SQL Editor (profiles + RLS + usage RPC + optional auth trigger).
#
# Upgrade to Pro uses POST /create-checkout-session on the API (see server/index.mjs).
# Elite (signed-in): POST /api/billing/start-elite with Authorization — Free → Checkout; Pro → same subscription + proration invoice (requires STRIPE_ELITE_PRICE_ID).
# Point the frontend at the API with VITE_API_BASE_URL when needed.
